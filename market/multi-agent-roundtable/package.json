{
  "name": "@p-dsh-market/multi-agent-roundtable",
  "version": "0.4.0",
  "description": "DSH 多 Agent 圆桌讨论：独立会话、角色 Prompt、交叉评审与 Markdown 消息流",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "p-dsh-market",
    "multi-agent",
    "roundtable",
    "agent-review"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./config-storage": "./lib/config-storage.js",
    "./conversation-storage": "./lib/conversation-storage.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/config-storage.js",
    "lib/conversation-storage.js",
    "lib/orchestration.js",
    "lib/protocol.js",
    "lib/role-schema.js",
    "lib/tool.js",
    "presets/default-roles.json",
    "skills/multi-agent-roundtable/SKILL.md",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "protocolVersion": 1,
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "market": {
      "displayName": "多 Agent 圆桌讨论",
      "capabilities": ["skills", "host", "client", "desktop-shell"]
    },
    "desktop": {
      "permissions": ["shell:titlebar"],
      "contributes": {
        "titlebarActions": [
          {
            "id": "open-roundtable",
            "slot": "desktop.titlebar.workspaceActions",
            "label": "圆桌",
            "order": 130,
            "when": ["dshRunning", "pluginActive", "restartNotRequired"],
            "action": {
              "type": "pluginRpc",
              "method": "multiAgentRoundtable.open"
            }
          }
        ]
      }
    }
  }
}
