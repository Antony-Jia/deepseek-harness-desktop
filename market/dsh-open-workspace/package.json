{
  "name": "@p-dsh-market/dsh-open-workspace",
  "version": "0.1.6",
  "description": "DSH 工作区文件浏览器：悬浮层级目录、Markdown/代码/HTML 预览与工作区终端",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "p-dsh-market",
    "@p-dsh-market",
    "dsh-open-workspace",
    "workspace",
    "file-browser",
    "markdown",
    "html"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "protocolVersion": 1,
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "market": {
      "displayName": "工作区文件浏览器",
      "capabilities": ["skills", "host", "client", "desktop-shell"]
    },
    "desktop": {
      "permissions": [
        "shell:titlebar",
        "workspace:read",
        "native:open-folder",
        "native:open-terminal"
      ],
      "contributes": {
        "titlebarActions": [
          {
            "id": "open-folder",
            "slot": "desktop.titlebar.workspaceActions",
            "label": "文件夹",
            "icon": "folder",
            "order": 100,
            "when": ["workspaceSelected", "dshRunning", "pluginActive", "restartNotRequired"],
            "action": {
              "type": "native",
              "command": "workspace.openFolder"
            }
          },
          {
            "id": "open-terminal",
            "slot": "desktop.titlebar.workspaceActions",
            "label": "Terminal",
            "icon": "terminal",
            "order": 110,
            "when": ["workspaceSelected", "dshRunning", "pluginActive", "restartNotRequired"],
            "action": {
              "type": "native",
              "command": "workspace.openTerminal"
            }
          }
        ]
      },
      "storage": []
    }
  }
}
